@import "koda-colors"

configuration {
  modi:                "drun,ssh";
  show-icons:          true;
  display-drun:        "APPS";
  display-ssh:         "SSH";
  drun-display-format: "{name}";
  drun-match-fields:   "name,generic";
  window-format:       "{w} · {c} · {t}";
}

window {
    background-color:  #101010AB;
    border:            0px  2px 0px 0px;
    border-color:      @border;
    border-radius:     0px;
    width:             700px;
    padding:           0px;
    location:          west;
    anchor:            west;
    height:            100%;
}

mainbox {
    background-color:  transparent;
    children:          [ inputbar, listview, message, mode-switcher-bar ];
    spacing:           0px;
}

mode-switcher {
    background-color:  transparent;
    border:            0px 0px 1px 0px;
    border-color:      @border;
    padding:           0px;
    spacing:           0px;
}

mode-switcher-bar {
    background-color:  #101010AB;
    border:            2px  0px 0px 0px;
    border-color:      @border;
    fixed-height:      32px;
    children:          [ mode-switcher ];
    expand:            false;
}

button {
    border:            1px;
    border-color:      @border;
    background-color:  @bg;
    text-color:        @fg;
    padding:           2px 20px;
    expand:            false;
    font:              "JetBrainsMono Nerd Font 9";
}

button selected {
    background-color:  @highlight;
    text-color:        @fg-selected;
}

inputbar {
    background-color:  @bg;
    text-color:        @fg;
    padding:           16px 18px;
    spacing:           10px;
    children:          [ entry ];
}

prompt {
    background-color:  transparent;
    text-color:        @fg-dim;
}

entry {
    background-color:  transparent;
    text-color:        @fg-dim;
    placeholder:       "Search...";
    placeholder-color: @fg-dim;
}

listview {
    background-color:  @bg;
    border:            1px 0px 0px 0px;
    border-color:      @border;
    spacing:           4px;
    lines:             6;
    columns:           1;
    fixed-height:      true;
    dynamic:           false;
}

element {
    background-color:  transparent;
    text-color:        @fg;
    padding:           10px 12px;
    spacing:           10px;
    orientation:       horizontal;
}

element selected {
    background-color:  @highlight;
    text-color:        @fg-selected;
    border:            1px;
    border-color:      @border;
}

element-icon {
    size:              48px;
    background-color:  transparent;
    vertical-align:    0.5;
}

element-text {
    background-color:  transparent;
    text-color:        inherit;
    vertical-align:    0.5;
    horizontal-align:  0.0;
}

element-text selected.normal {
    highlight: bold underline;
}

message {
    enabled:           true;
    margin:            0px;
    padding:           0px;
    border:            0px solid;
    border-radius:     0px 0px 0px 0px;
    border-color:      @border;
    background-color:  transparent;
    text-color:        @fg;
}

textbox {
    padding:           12px;
    border:            0px solid;
    border-radius:     0px;
    border-color:      @border;
    background-color:  @bg-alt;
    text-color:        @active;
    vertical-align:    0.5;
    horizontal-align:  0.0;
    highlight:         none;
    placeholder-color: @fg;
    blink:             true;
    markup:            true;
}

error-message {
    padding:           10px;
    border:            2px solid;
    border-radius:     0px;
    border-color:      @border;
    background-color:  @bg;
    text-color:        @urgent;
}
