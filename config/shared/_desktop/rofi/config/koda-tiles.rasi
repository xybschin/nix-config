@import "koda-base"

configuration {
  show-icons:        false;
}

window {
    transparency:      "real";
    width:             480px;
    border-radius:     @radius;
    padding:           4px;
}

mainbox {
    enabled:           true;
    margin:            0px;
    children:          [ listview ];
}

listview {
    enabled:           true;
    columns:           4;
    lines:             1;
    dynamic:           true;
    scrollbar:         false;
    layout:            vertical;
    reverse:           false;
    fixed-height:      true;
    fixed-columns:     true;
    spacing:           4px;
    margin:            0px;
    padding:           0px;
    border:            0px solid;
    border-color:      @highlight;
    background-color:  transparent;
    text-color:        @fg;
    cursor:            "default";
}

element {
    enabled:           true;
    spacing:           0px;
    margin:            0px;
    padding:           36px 0px;
    border:            0px solid;
    border-color:      @highlight;
    background-color:  @bg;
    cursor:            pointer;
    orientation:       vertical;
    children:          [ element-text ];
}

element-text {
    font:              @font-lg;
    cursor:            inherit;
    horizontal-align:  0.5;
    expand:            true;
}
