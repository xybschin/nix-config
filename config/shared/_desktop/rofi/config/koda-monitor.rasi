@import "koda-power"

configuration {
  show-icons:        true;
}

element {
    children:          [ element-icon ];
    padding:           26px 0px;
}

element-icon {
    size:              56px;
    background-color:  transparent;
    cursor:            inherit;
    expand:            false;
    horizontal-align:  0.5;
    vertical-align:    0.5;
}

element-icon selected.normal {
    tint:              @accent;
}
