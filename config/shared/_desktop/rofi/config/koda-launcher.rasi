@import "koda-base"

configuration {
  modi:                "drun";
  show-icons:          true;
  display-drun:        "APPS";
  drun-display-format: "{name}";
  drun-match-fields:   "name,generic";
  window-format:       "{w} · {c} · {t}";
}

window {
    border-radius:     @radius-lg;
    width:             720px;
    padding:           0px;
}

mainbox {
    children:          [ inputbar, listview, message ];
    spacing:           0px;
}

inputbar {
    background-color:  transparent;
    text-color:        @fg;
    padding:           16px 18px;
    spacing:           10px;
    children:          [ entry ];
}

prompt {
    background-color:  transparent;
    text-color:        @fg-dim;
}

entry {
    background-color:  transparent;
    text-color:        @fg-dim;
    placeholder:       "Search...";
    placeholder-color: @fg-dim;
}

message {
    enabled:           true;
    margin:            0px;
    padding:           0px;
    border:            0px solid;
    border-radius:     0px 0px 0px 0px;
    border-color:      @border;
    background-color:  transparent;
    text-color:        @fg;
}

textbox {
    padding:           12px;
    border:            0px solid;
    border-radius:     0px;
    border-color:      @border;
    background-color:  @bg-alt;
    text-color:        @active;
    vertical-align:    0.5;
    horizontal-align:  0.0;
    highlight:         none;
    placeholder-color: @fg;
    blink:             true;
    markup:            true;
}

listview {
    background-color:  transparent;
    border:            1px 0px 0px 0px;
    border-color:      @border;
    spacing:           4px;
    lines:             6;
    columns:           1;
    fixed-height:      true;
    dynamic:           false;
    padding:           0 0 6px 0;
}

element {
    padding:           10px 12px;
    spacing:           10px;
    orientation:       horizontal;
    margin:            6px 12px 0px 12px;
}

element-icon {
    size:              32px;
    background-color:  transparent;
    vertical-align:    0.5;
}

element-text {
    horizontal-align:  0.0;
}

element-text selected.normal {
    highlight: bold underline;
}

error-message {
    padding:           10px;
    border:            2px solid;
    border-radius:     0px;
    border-color:      @border;
    background-color:  @bg;
    text-color:        @urgent;
}
