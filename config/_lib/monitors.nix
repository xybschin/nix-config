{ lib }:
# Renders the Hyprland Lua for monitor profiles. Pure: data in, string out.
#
# profiles: [ { name; outputs = [ { name; enabled; mode; position; scale;
#               workspaces = [ int ]; } ]; } ]  (the first is the default)
rec {
  outputLua =
    o:
    if o.enabled then
      ''hl.monitor({ output = "${o.name}", mode = "${o.mode}", position = "${o.position}", scale = ${toString o.scale} })''
    else
      ''hl.monitor({ output = "${o.name}", disabled = true })'';

  workspaceLua =
    gamingWorkspace: o:
    map (
      w:
      let
        noGaps = lib.optionalString (w == gamingWorkspace) ", gaps_in = 0, gaps_out = 0";
      in
      ''hl.workspace_rule({ workspace = "${toString w}", monitor = "${o.name}"${noGaps} })''
    ) (lib.sort (a: b: a < b) o.workspaces);

  indent = lib.concatMapStringsSep "\n" (l: "\t\t" + l);

  profileLua =
    gamingWorkspace: p:
    let
      lines =
        map outputLua p.outputs
        ++ lib.concatMap (workspaceLua gamingWorkspace) (lib.filter (o: o.enabled) p.outputs);
    in
    ''
      	["${p.name}"] = function()
      ${indent lines}
      	end,'';

  renderLua =
    {
      profiles,
      alwaysDisabled,
      gamingWorkspace,
      stateFileName,
      applyScript,
    }:
    let
      default = (lib.head profiles).name;
      # The gaming workspace, exported for host-level Lua (window rules)
      # and bound to SUPER + g. Absent when no gaming workspace is set.
      gaming = lib.optionalString (gamingWorkspace != null) ''
        GAMING_WORKSPACE = ${toString gamingWorkspace}

        hl.bind("SUPER + g", hl.dsp.focus({ workspace = tostring(GAMING_WORKSPACE) }))
      '';
    in
    ''
      -- Generated by the shared.desktop.monitors feature; do not edit.
      local state_file = (os.getenv("XDG_STATE_HOME") or (os.getenv("HOME") .. "/.local/state"))
      	.. "/${stateFileName}"

      local profiles = {
      ${lib.concatMapStringsSep "\n" (profileLua gamingWorkspace) profiles}
      }

      local profile = "${default}"
      local f = io.open(state_file, "r")
      if f then
      	profile = f:read("*line") or profile
      	f:close()
      end

      -- An unknown or stale state falls back to the default profile.
      local apply = profiles[profile] or profiles["${default}"]
      apply()
      ${lib.concatMapStringsSep "\n" (
        n: ''hl.monitor({ output = "${n}", disabled = true })''
      ) alwaysDisabled}

      ${gaming}
      hl.on("hyprland.start", function()
      	hl.exec_cmd("${applyScript}")
      end)
    '';
}
