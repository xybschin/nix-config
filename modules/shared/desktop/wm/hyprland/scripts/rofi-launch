#!/usr/bin/env bash
set -euo pipefail

# Launches rofi and temporarily adds top padding to the active workspace
# so tiled windows move below the rofi bar. Rofi stays pinned to the top
# via the "overlay" layer in its theme. Height is hardcoded to avoid
# layer-shell reporting the full listview height on first launch.
#
# The gap follows the user across workspace switches while rofi is open.
# All workspaces that received a gap are tracked and cleaned up on exit
# to prevent orphaned gaps from pushing windows out of view.

# Only one instance at a time — a second keypress while rofi is open
# would spawn a rofi process that exits immediately, causing the gap
# to be reset while rofi is still visible.
exec 9>/tmp/rofi-launch.lock
flock -n 9 || exit 0

ws=$(hyprctl activeworkspace 2>/dev/null | head -1 | grep -oP 'workspace ID \K\d+')

if [[ "$ws" == special* ]]; then
    exec rofi "$@"
fi

if [ $# -eq 0 ]; then
    set -- -show drun
fi

rofi "$@" &
rofi_pid=$!

# Hardcoded height to match the rofi bar (inputbar + theme padding).
height=36

set_gap() {
    local target=$1
    local h=$2
    if [ -n "$h" ] && [ "$h" -gt 0 ] 2>/dev/null; then
        hyprctl eval "hl.workspace_rule({ workspace = '${target}', gaps_out = { top = ${h}, right = 0, bottom = 0, left = 0 } })" 2>/dev/null || true
    fi
}

clear_gap() {
    local target=$1
    hyprctl eval "hl.workspace_rule({ workspace = '${target}', gaps_out = { top = 0, right = 0, bottom = 0, left = 0 } })" 2>/dev/null || true
}

if [ -n "$height" ] && [ "$height" -gt 0 ] 2>/dev/null; then
    set_gap "$ws" "$height"

    # Poll for workspace changes while rofi is open — move the gap
    # to whichever workspace the user switches to.  Write every
    # workspace that received a gap to fd 3 so the parent can clean
    # them all up (subshell variables don't propagate back).
    exec 3>/tmp/rofi-gapped-ws
    echo "$ws" >&3
    (
        last_ws="$ws"
        while kill -0 "$rofi_pid" 2>/dev/null; do
            cur_ws=$(hyprctl activeworkspace 2>/dev/null | head -1 | grep -oP 'workspace ID \K\d+')
            if [ "$cur_ws" != "$last_ws" ] && [ -n "$cur_ws" ]; then
                clear_gap "$last_ws"
                set_gap "$cur_ws" "$height"
                echo "$cur_ws" >&3
                last_ws="$cur_ws"
            fi
            sleep 0.05
        done
    ) &
    poll_pid=$!

    wait "$rofi_pid" 2>/dev/null || true

    # Stop the polling loop.
    kill "$poll_pid" 2>/dev/null || true
    wait "$poll_pid" 2>/dev/null || true
    exec 3>&-

    # Clear gap on every workspace that received one — not just the
    # currently active one, which may have changed while rofi was open.
    sort -u /tmp/rofi-gapped-ws | while read -r gws; do
        clear_gap "$gws"
    done
    rm -f /tmp/rofi-gapped-ws
else
    wait "$rofi_pid" 2>/dev/null || true
fi
