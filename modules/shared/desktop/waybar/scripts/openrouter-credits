#!/usr/bin/env bash
# Waybar widget: remaining OpenRouter credits.
#
# Reads the API key from the $OPENROUTER_API_KEY environment variable.
set -euo pipefail

emit() { # <text> <tooltip> <class>
    jq -nc --arg text "$1" --arg tooltip "$2" --arg class "$3" \
        '{text:$text, tooltip:$tooltip, class:$class}'
}

money() { awk -v n="$1" 'BEGIN{ printf "%.2f", n+0 }'; }

if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
    emit "OR: no key" "OPENROUTER_API_KEY is not set" "error"
    exit 0
fi

resp="$(curl -fsS -H "Authorization: Bearer $OPENROUTER_API_KEY" \
    https://openrouter.ai/api/v1/credits 2>/dev/null)" || {
    emit "OR: request failed" "curl failed" "error"
    exit 0
}

total="$(printf '%s' "$resp" | jq -r '.data.total_credits // empty')"
usage="$(printf '%s' "$resp" | jq -r '.data.total_usage // empty')"

if [[ -z "$total" || -z "$usage" ]]; then
    emit "OR: no data" "$(printf '%s' "$resp" | jq -c . 2>/dev/null || printf '%s' "$resp')" "error"
    exit 0
fi

# Remaining credits = total purchased minus all-time usage.
remaining="$(awk -v t="$total" -v u="$usage" 'BEGIN{ printf "%.2f", t - u }')"

text="$(printf 'OR $%s' "$remaining")"
tooltip="$(printf 'OpenRouter credits\nRemaining: $%s' "$remaining")"

class="ok"

emit "$text" "$tooltip" "$class"
